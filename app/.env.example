# --- Backend ---------------------------------------------------------------
# Ziel des Dev-Proxys. Der Standard entspricht dem http-Profil aus
# src/TennisTurnier.Api/Properties/launchSettings.json.
VITE_API_PROXY_TARGET=http://localhost:5188

# Basis-URL der API. Leer lassen heißt "gleiche Herkunft" — im Dev-Betrieb also
# über den Vite-Proxy. Nur setzen, wenn das Backend getrennt ausgeliefert wird
# und CORS dort konfiguriert ist.
VITE_API_BASE_URL=

# --- Anmeldung (OIDC) ------------------------------------------------------
# Aussteller. Lokal Keycloak aus docker-compose.yml, in Produktion Entra ID.
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/tennisturnier

# Öffentlicher Client aus deploy/keycloak/tennisturnier-realm.json.
VITE_OIDC_CLIENT_ID=tennisturnier-api

# Muss der Audience des Backends entsprechen (appsettings: Oidc:Audience),
# sonst weist die API das Token zurück.
VITE_OIDC_SCOPE=openid profile email
