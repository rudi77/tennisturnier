<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- Alle geerbten Quellen (z. B. firmeninterne Feeds aus %APPDATA%\NuGet\NuGet.Config)
       verwerfen: dieses Projekt bezieht ausschliesslich oeffentliche Pakete. Eine einzelne
       Quelle vermeidet ausserdem NU1507 (Central Package Management verlangt sonst
       Package Source Mapping). -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

</configuration>
