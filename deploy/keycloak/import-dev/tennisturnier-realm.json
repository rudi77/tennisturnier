{
  "realm": "tennisturnier",
  "displayName": "MATCHDAY",
  "displayNameHtml": "<strong>MATCHDAY</strong>",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "verifyEmail": true,
  "accessTokenLifespan": 3600,
  "clients": [
    {
      "clientId": "tennisturnier-api",
      "name": "Tennisturnier API",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:5000/",
        "http://localhost:5000/?*",
        "http://192.168.2.213:5000/",
        "http://192.168.2.213:5000/?*",
        "http://localhost:5001/",
        "http://localhost:5001/?*",
        "${MATCHDAY_ORIGIN:http://localhost:5000}/",
        "${MATCHDAY_ORIGIN:http://localhost:5000}/?*"
      ],
      "webOrigins": [
        "http://localhost:5000",
        "http://192.168.2.213:5000",
        "http://localhost:5001",
        "${MATCHDAY_ORIGIN:http://localhost:5000}"
      ],
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "tennisturnier-api",
            "access.token.claim": "true"
          }
        }
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:5000/##http://localhost:5000/?*##http://localhost:5001/##http://localhost:5001/?*##http://192.168.2.213:5000/##http://192.168.2.213:5000/?*##${MATCHDAY_ORIGIN:http://localhost:5000}/##${MATCHDAY_ORIGIN:http://localhost:5000}/?*",
        "pkce.code.challenge.method": "S256"
      }
    }
  ],
  "users": [
    {
      "username": "systemadmin",
      "enabled": true,
      "emailVerified": true,
      "email": "systemadmin@example.invalid",
      "firstName": "System",
      "lastName": "Administrator",
      "credentials": [
        {
          "type": "password",
          "value": "systemadmin",
          "temporary": false
        }
      ]
    },
    {
      "username": "clubadmin",
      "enabled": true,
      "emailVerified": true,
      "email": "clubadmin@example.invalid",
      "firstName": "Vereins",
      "lastName": "Administrator",
      "credentials": [
        {
          "type": "password",
          "value": "clubadmin",
          "temporary": false
        }
      ]
    },
    {
      "username": "referee",
      "enabled": true,
      "emailVerified": true,
      "email": "referee@example.invalid",
      "firstName": "Schieds",
      "lastName": "Richter",
      "credentials": [
        {
          "type": "password",
          "value": "referee",
          "temporary": false
        }
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "providerId": "google",
      "enabled": "${KC_GOOGLE_ENABLED:false}",
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${KC_GOOGLE_CLIENT_ID:}",
        "clientSecret": "${KC_GOOGLE_CLIENT_SECRET:}",
        "defaultScope": "openid profile email",
        "syncMode": "IMPORT",
        "updateProfileFirstLoginMode": "off",
        "useJwksUrl": "true"
      }
    }
  ],
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": false,
  "rememberMe": true,
  "duplicateEmailsAllowed": false
}
