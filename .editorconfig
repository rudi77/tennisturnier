root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md,csproj,props,targets,slnx}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Namensräume gespiegelt zur Ordnerstruktur, dateiweite Deklaration
csharp_style_namespace_declarations = file_scoped:error
dotnet_diagnostic.IDE0161.severity = error

# var nur, wo der Typ ohnehin dasteht
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Moderne Ausdrücke bevorzugen
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_prefer_braces = true:suggestion

# using-Direktiven außerhalb des Namensraums, System zuerst
csharp_using_directive_placement = outside_namespace:error
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Ungenutzte Werte sind fast immer ein Fehler
dotnet_diagnostic.IDE0059.severity = warning
dotnet_diagnostic.IDE0060.severity = warning

# Sichtbarkeit immer explizit
dotnet_style_require_accessibility_modifiers = for_non_interface_members:error

# Nullable-Verstöße bleiben Fehler (TreatWarningsAsErrors greift ohnehin)
dotnet_diagnostic.CS8618.severity = error
dotnet_diagnostic.CS8625.severity = error

[tests/**/*.cs]
# Testnamen dürfen Unterstriche und Umlaute tragen: Test_liest_sich_wie_ein_Satz
dotnet_diagnostic.CA1707.severity = none
